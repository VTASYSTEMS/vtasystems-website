<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>VTA Systems | Loa DIY Công Suất Cao</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
*{
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Montserrat', Arial, Helvetica, sans-serif;
}

body{
  background: #0b0b0b;
  color: #ffffff;
  overflow-x: hidden;
}

/* THANH CHỮ CHẠY NGANG (TICKER MARQUEE - MÀU CAM MASTER) */
.ticker-bar {
  background: #ff6600; /* Màu cam chủ đạo */
  color: #000000; /* Chữ đen tạo độ tương phản cao */
  overflow: hidden;
  white-space: nowrap;
  box-sizing: border-box;
  padding: 10px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
}

.ticker-track {
  display: flex;
  width: max-content;
  animation: marquee 8s linear infinite;
}

.ticker-bar:hover .ticker-track {
  animation-play-state: paused;
}

.ticker-item {
  font-size: 15px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 2px;
  padding: 0 30px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.ticker-item i {
  font-size: 14px;
  color: #ffffff; /* Icon màu trắng */
}

@keyframes marquee {
  0% { transform: translateX(0%); }
  100% { transform: translateX(-50%); }
}

/* HEADER */
header{
  height: 75px;
  background: #111111;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 50px;
  border-bottom: 2px solid #222222;
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo{
  font-size: 26px;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 2px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.logo span {
  color: #ff6600; /* Màu cam */
}

nav a{
  color: #ffffff;
  text-decoration: none;
  margin-left: 30px;
  font-weight: 600;
  transition: .3s;
}

nav a:hover{
  color: #ff6600;
}

/* HERO SECTION */
.hero{
  padding: 80px 20px 50px;
  background: linear-gradient(180deg, #111111 0%, #000000 100%);
  text-align: center;
}

.hero h1{
  font-size: 55px;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 3px;
}

.hero h1 span {
  color: #ff6600;
}

.hero h2{
  font-size: 22px;
  margin-top: 10px;
  color: #cccccc;
  font-weight: 500;
}

.hero p{
  margin: 15px auto 0;
  color: #888888;
  font-size: 17px;
  max-width: 650px;
}

/* BRAND BANNER (NỀN CAM NỔI BẬT) */
.brand-statement {
  background: linear-gradient(135deg, #ff6600 0%, #cc5200 100%);
  color: #ffffff;
  padding: 70px 20px;
  text-align: center;
}

.brand-statement-container {
  max-width: 850px;
  margin: 0 auto;
}

.brand-statement h2 {
  font-size: 36px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  line-height: 1.25;
  margin-bottom: 25px;
}

.brand-statement p {
  font-size: 18px;
  line-height: 1.7;
  color: #ffffff;
  opacity: 0.95;
  font-weight: 400;
}

/* PRODUCTS SECTION */
.products-section {
  padding: 80px 40px;
  max-width: 1200px;
  margin: 0 auto;
}

.section-title {
  text-align: center;
  font-size: 36px;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 50px;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.section-title span {
  color: #ff6600;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 40px;
}

.product-card {
  background: #141414;
  border: 1px solid #222222;
  border-radius: 12px;
  padding: 25px;
  text-align: center;
  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-card:hover {
  transform: translateY(-8px);
  border-color: #ff6600;
  box-shadow: 0 10px 25px rgba(255, 102, 0, 0.25);
}

/* SLIDER XEM ẢNH */
.product-slider-wrapper {
  position: relative;
  margin-bottom: 15px;
}

.product-slider {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  border-radius: 8px;
  background: #080808;
  padding: 10px 0;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.product-slider::-webkit-scrollbar {
  display: none;
}

.product-slider img {
  flex: 0 0 100%;
  width: 100%;
  height: 280px;
  object-fit: contain;
  scroll-snap-align: start;
}

.swipe-hint {
  font-size: 12px;
  color: #ff6600;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
}

.product-brand {
  font-size: 13px;
  color: #777777;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-bottom: 4px;
}

.product-card h3 {
  font-size: 26px;
  color: #ffffff;
  margin-bottom: 8px;
}

.product-card .tagline {
  color: #ff6600;
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 12px;
  text-transform: uppercase;
}

/* THÔNG SỐ KỸ THUẬT */
.tech-specs {
  text-align: left;
  background: #0d0d0d;
  padding: 12px;
  border-radius: 6px;
  margin-bottom: 20px;
  border: 1px solid #1f1f1f;
}

.tech-specs li {
  list-style: none;
  font-size: 13px;
  color: #cccccc;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.tech-specs li:last-child {
  margin-bottom: 0;
}

.tech-specs i {
  color: #ff6600;
  width: 16px;
  text-align: center;
}

.button{
  display: inline-block;
  padding: 12px 30px;
  background: #ff6600;
  color: #ffffff;
  text-decoration: none;
  border-radius: 6px;
  font-weight: bold;
  transition: all 0.3s ease;
}

.button:hover{
  background: #ff8533;
  box-shadow: 0 4px 12px rgba(255, 102, 0, 0.4);
}

/* FOOTER */
footer {
  background: #080808;
  border-top: 1px solid #222222;
  padding: 60px 40px 20px;
  color: #bbb;
}

.footer-container {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 40px;
}

.footer-col h4 {
  color: #ffffff;
  font-size: 16px;
  text-transform: uppercase;
  margin-bottom: 15px;
  letter-spacing: 1px;
}

.footer-col ul {
  list-style: none;
}

.footer-col ul li {
  margin-bottom: 12px;
}

.footer-col ul li a {
  color: #aaaaaa;
  text-decoration: none;
  font-size: 14px;
  transition: color 0.3s ease;
}

.footer-col ul li a:hover {
  color: #ff6600;
}

.footer-bottom {
  max-width: 1200px;
  margin: 40px auto 0;
  padding-top: 20px;
  border-top: 1px solid #1a1a1a;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-brand-logo {
  font-size: 28px;
  font-weight: 900;
  color: #ff6600;
  letter-spacing: 4px;
}

@media (max-width: 768px) {
  header { padding: 0 20px; }
  nav { display: none; }
  .hero h1 { font-size: 36px; }
  .ticker-item { font-size: 13px; padding: 0 15px; }
}
</style>
</head>
